# Copy this file to .env and fill in real values. Never commit .env.
# Variable names only — every value below is a placeholder.

APP_ENV=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local Docker Compose setup: set the parts below and leave DATABASE_URL empty.
POSTGRES_USER=voice_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=voice_sales
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Hosted Postgres (for example Neon): set DATABASE_URL and it wins over the
# POSTGRES_* parts above. The driver must be postgresql+asyncpg.
# Use ssl=require, NOT sslmode=require: asyncpg does not accept sslmode.
# DATABASE_URL=postgresql+asyncpg://user:password@host.example.com/dbname
# DB_SSL=require
# Production (APP_ENV=production) requires TLS: DB_SSL=require, verify-ca or verify-full,
# or ssl=require in DATABASE_URL. disable, allow and prefer are refused.

# Connection pool. Keep these small on a hosted/serverless database.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800

# Set to 0 only when connecting through a transaction pooler
# (for example a Neon "-pooler" host), which cannot hold prepared statements.
# DB_PREPARED_STATEMENT_CACHE_SIZE=0

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# Redis is used only by the /readyz check today. Set REDIS_ENABLED=false to run
# without Redis; /readyz then reports on Postgres alone instead of failing.
REDIS_ENABLED=true
REDIS_PASSWORD=change-me
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# ---------------------------------------------------------------------------
# LLM (Groq)
# ---------------------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=600
CHAT_HISTORY_LIMIT=10

# ---------------------------------------------------------------------------
# Voice
# ---------------------------------------------------------------------------
# Printed by: python -m scripts.seed_demo
VOICE_AGENT_ID=00000000-0000-0000-0000-000000000000
VOICE_GREETING=Hi there! How can I help you today?

# Private voice access. Visitors need a short-lived token from POST /v1/voice/tokens.
# Generate the secret once, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
# Set the same value for the voice bot and the text API. Never expose it to a browser.
# VOICE_TOKEN_SECRET=
# VOICE_TOKEN_TTL_SECS=300
# VOICE_REASONING_EFFORT=low

# Text-to-speech: groq or deepgram.
# DEEPGRAM_API_KEY is required when TTS_PROVIDER=deepgram.
TTS_PROVIDER=deepgram
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_TTS_VOICE=aura-2-helena-en

# Call guards for a public demo (protect paid Groq/Deepgram/TURN quota).
# 0 or unset means no cap. Set a duration before exposing a public URL.
VOICE_MAX_CALL_SECONDS=300
VOICE_MAX_CONCURRENT_CALLS=1
# How long a disconnect waits for an in-flight save_lead commit before cancelling the
# call anyway (seconds). Bounded on purpose - a stuck save must never block shutdown.
LEAD_SAVE_DISCONNECT_GRACE_SECS=3.0

# ---------------------------------------------------------------------------
# Knowledge base (RAG)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=.models
RAG_TOP_K=4
RAG_MAX_DISTANCE=0.30

# ---------------------------------------------------------------------------
# Voice transport (read by the Pipecat runner, not by api/config.py)
# ---------------------------------------------------------------------------
# On localhost the browser and the bot are on the same machine, so no ICE
# server is needed. Anywhere else the bot gathers host candidates only and a
# remote visitor cannot connect. Set STUN *and* a TURN relay before deploying:
# PIPECAT_ICE_SERVERS=stun:stun.l.google.com:19302
# PIPECAT_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"secret"}]
#
# Restrict who may post a WebRTC offer once the runner is public:
# PIPECAT_ALLOWED_ORIGINS=https://your-demo-host.example.com

# ---------------------------------------------------------------------------
# Evaluation and optional LangSmith tracing (see docs/EVALUATION_PLAN.md and
# docs/LANGSMITH.md). Placeholders only. Tracing stays off unless both
# LANGSMITH_TRACING=true and a real key are set; needs requirements-eval.txt.
# ---------------------------------------------------------------------------
# EVAL_RESULTS_DIR=evals/results
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=voice-sales-agent
# LANGSMITH_ENDPOINT=
# Also send visitor text and prompts to LangSmith. Leave false for real traffic.
# LANGSMITH_TRACE_CONTENT=false

# Optional Gemini LLM judge for evaluations (needs its own API key and billing in
# Google AI Studio; a Gemini app subscription does not include API quota). Evaluation only.
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_JUDGE_MODEL=<a model id available to your key>
# Read timeout for judge calls only, in seconds (default 60; must be > 0 and <= 600). Does not affect
# LLM_TIMEOUT_SECONDS or the voice agent. A read timeout is not retried (the request may already be billed).
# GEMINI_JUDGE_TIMEOUT_SECONDS=60
